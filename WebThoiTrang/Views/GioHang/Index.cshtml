@model List<WebThoiTrang.Controllers.GioHangItem>
@{
    ViewBag.Title = "Giỏ hàng";
    decimal tongTien = 0;
}

<div class="container mt-5 mb-5">
    <h2 class="fw-bold mb-4">Giỏ hàng của bạn</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-cart-arrow-down text-muted mb-3" style="font-size: 4rem;"></i>
            <h4>Giỏ hàng đang trống</h4>
            <p class="text-muted">Hãy khám phá và thêm những sản phẩm yêu thích nhé.</p>
            <a href="/Home/Index" class="btn btn-dark px-4 py-2 mt-2 rounded-pill">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="bg-white rounded-4 shadow-sm p-4">
                    @foreach (var item in Model)
                    {
                        var thanhTien = item.BienThe.GiaBan * item.SoLuong;
                        tongTien += thanhTien;

                        <div class="row align-items-center border-bottom pb-3 mb-3">
                            <div class="col-3 col-md-2">
                                <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=200&q=80" class="img-fluid rounded" style="object-fit: cover;" />
                            </div>
                            <div class="col-9 col-md-4">
                                <h6 class="fw-bold mb-1">@(item.BienThe.SanPham != null ? item.BienThe.SanPham.TenSanPham : "Sản phẩm mẫu")</h6>
                                <p class="text-muted small mb-0">Phân loại: @item.BienThe.KichCo / @item.BienThe.MauSac</p>
                            </div>
                            <div class="col-4 col-md-2 text-md-center mt-2 mt-md-0">
                                <span class="text-muted d-md-none small">Giá:</span>
                                <span class="fw-medium">@item.BienThe.GiaBan.ToString("N0") đ</span>
                            </div>
                            <div class="col-4 col-md-2 text-md-center mt-2 mt-md-0">
                                <span class="text-muted d-md-none small">SL:</span>
                                <span class="badge bg-light text-dark border px-3 py-2">@item.SoLuong</span>
                            </div>
                            <div class="col-4 col-md-2 text-end mt-2 mt-md-0">
                                <span class="text-danger fw-bold d-block mb-1">@thanhTien.ToString("N0") đ</span>
                                <a href="/GioHang/Xoa?maBienThe=@item.BienThe.MaBienThe" class="text-danger small text-decoration-none"><i class="fa-solid fa-trash-can"></i> Xóa</a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white rounded-4 shadow-sm p-4" style="position: sticky; top: 100px;">
                    <h5 class="fw-bold mb-4">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Tạm tính</span>
                        <span>@tongTien.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Phí vận chuyển</span>
                        <span class="text-success">Miễn phí</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Tổng cộng</span>
                        <span class="text-danger fw-bold fs-4">@tongTien.ToString("N0") đ</span>
                    </div>
                    <a href="/GioHang/ThanhToan" class="btn btn-dark w-100 py-3 rounded-pill fw-bold">TIẾN HÀNH THANH TOÁN</a>
                    <a href="/Home/Index" class="btn btn-link w-100 text-muted mt-2 text-decoration-none">Mua thêm sản phẩm</a>
                </div>
            </div>
        </div>
    }
</div>