@model WebThoiTrang.Models.SanPham
@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<div class="row mt-4">
    <div class="col-md-5">
        <img src="@Model.HinhAnhDaiDien" class="img-fluid rounded shadow" />
    </div>
    <div class="col-md-7">
        <h2>@Model.TenSanPham</h2>
        <p class="text-muted">Danh mục: @Model.DanhMuc?.TenDanhMuc</p>
        <hr />
        <h4 class="text-danger mb-4">
            Giá từ: @(Model.BienTheSanPham.FirstOrDefault()?.GiaBan.ToString("N0")) đ
        </h4>
        <p>@Model.MoTa</p>

        <form action="/GioHang/ThemVao" method="post" class="mt-4 border p-3 rounded bg-light">
            <h5>Chọn phân loại:</h5>
            <select name="maBienThe" class="form-select mb-3" required>
                @foreach (var bt in Model.BienTheSanPham)
                {
                    <option value="@bt.MaBienThe">@bt.KichCo - @bt.MauSac (Còn @bt.SoLuongTon)</option>
                }
            </select>

            <div class="d-flex align-items-center mb-3">
                <label class="me-3">Số lượng:</label>
                <input type="number" name="soLuong" value="1" min="1" class="form-control" style="width: 100px;" />
            </div>

            <button type="submit" class="btn btn-dark w-100">Thêm vào giỏ hàng</button>
        </form>

        <a href="/Home/Index" class="btn btn-link mt-3 px-0">&larr; Quay lại trang chủ</a>
    </div>
</div>