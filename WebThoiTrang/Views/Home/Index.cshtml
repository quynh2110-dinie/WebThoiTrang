@model WebThoiTrang.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";


}

<div class="rounded-4 overflow-hidden position-relative shadow" style="background-image: url('https://cellphones.com.vn/sforum/cach-pha-mau-xanh-duong'); background-size: cover; background-position: center 20%; height: 450px;">
    
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-100 px-3" style="background: rgba(0,0,0,0.3);">
        <h1 class="display-3 fw-bold mb-3" style="font-family: serif;">Thời Trang Nữ</h1>
        <p class="fs-5 mb-4 fw-light">Khám phá phong cách thời trang mới dành riêng cho bạn</p>
        <a href="#featured" class="btn btn-light btn-lg px-5 rounded-pill fw-bold text-dark">Mua sắm ngay</a>
    </div>
</div>

<div class="container" id="featured">
    @if (ViewBag.CategoryHienTai != null) { 
    <h2 class="text-center mb-4" style="font-weight: bold; color: #4f6bed;">Danh mục: @ViewBag.CategoryHienTai</h2>}
    
    <div class="row justify-content-center mb-5">
        <div class="col-md-6">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "d-flex shadow-sm rounded-pill overflow-hidden border" }))
            {
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-0 px-4 py-3" placeholder="Tìm kiếm sản phẩm..." />
                <button type="submit" class="btn btn-dark px-4"><i class="fa-solid fa-magnifying-glass"></i></button>
            }
        </div>
    </div>

    
    @Html.Partial("_PVFeatureProduct", Model)
    @Html.Partial("_PVNewProduct", Model)
</div>